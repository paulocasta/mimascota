{
  "name": "mimascota",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "db:generate": "npm run db:generate -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.19"
  }
}
